    {
      "id": 49,
      "type": "table",
      "title": "Alerts Requiring Attention",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{severity=~\"critical|warning\",alertstate=~\"firing|pending\"}",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "minWidth": 130
          },
          "noValue": "No active alerts"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "severity",
                "alertstate",
                "alertname",
                "namespace",
                "pod",
                "node",
                "instance",
                "job",
                "persistentvolumeclaim",
                "name"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "severity": 0,
              "alertstate": 1,
              "alertname": 2
            },
            "renameByName": {
              "alertstate": "state",
              "alertname": "alert"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "severity",
                "desc": false
              }
            ]
          }
        }
      ],
      "description": "Firing and pending alerts with their affected resources. Empty is normal when the Active Alerts tile is zero.",
      "links": [
        {
          "title": "Monitoring",
          "url": "/d/homelab-monitoring?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 25,
      "type": "table",
      "title": "Flux Resources Not Ready",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "flux_resource_info{ready=\"False\"} or flux_resource_info{suspended=\"True\"}",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "minWidth": 130
          },
          "noValue": "Everything reconciled"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "cluster": true,
              "prometheus": true,
              "Value": true,
              "instance": true,
              "pod": true,
              "container": true,
              "endpoint": true,
              "namespace": true
            },
            "renameByName": {
              "exported_namespace": "namespace"
            }
          }
        }
      ],
      "description": "Anything Flux cannot reconcile, plus anything deliberately suspended. Empty is the correct state."
    },
    {
      "id": 24,
      "type": "table",
      "title": "Endpoint & Internet Checks",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{probe_group=~\"published|internet\"}",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "probe_duration_seconds{probe_group=~\"published|internet\"}",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "minWidth": 130
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "1": {
                        "text": "up",
                        "color": "#0ca30c",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#d03b3b",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "instance"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "instance",
                "Value #A",
                "Value #B"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "instance": "endpoint",
              "Value #A": "up",
              "Value #B": "seconds"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "up",
                "desc": false
              }
            ]
          }
        }
      ],
      "description": "Published services and internet probes, with failures first. Probes run from inside the cluster.",
      "links": [
        {
          "title": "Network",
          "url": "/d/homelab-network?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
