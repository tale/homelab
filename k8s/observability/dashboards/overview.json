    {
      "id": 8,
      "type": "stat",
      "title": "Postgres Backup Age",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - min(cnpg_collector_last_available_backup_timestamp > 0)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 86400
              },
              {
                "color": "#d03b3b",
                "value": 172800
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
