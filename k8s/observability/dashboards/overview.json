    {
      "id": 3,
      "type": "stat",
      "title": "Firing Alerts",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((count(ALERTS{alertstate=\"firing\",severity=~\"critical|warning\"})) or vector(0)) and on () (min(up{job=\"vmalert-victoria-metrics-k8s-stack\"}) == 1)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Monitoring",
          "url": "/d/homelab-monitoring?${__url_time_range}",
          "targetBlank": false
        }
      ],
      "description": "Warning and critical alerts. Pending alerts appear in the table."
