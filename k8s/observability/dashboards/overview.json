    {
      "id": 8,
      "type": "stat",
      "title": "Base Backup Age",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(cnpg_collector_last_available_backup_timestamp > 0)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
