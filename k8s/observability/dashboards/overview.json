    {
      "id": 9,
      "type": "stat",
      "title": "UPS Power",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(network_ups_tools_ups_status{flag=\"OL\"}) + 2 * max(network_ups_tools_ups_status{flag=\"OB\"}) + 4 * max(network_ups_tools_ups_status{flag=~\"LB|FSD|OFF|OVER|RB|SD\"})",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown",
                  "color": "#fab219",
                  "index": 0
                },
                "1": {
                  "text": "Online",
                  "color": "#0ca30c",
                  "index": 1
                },
                "2": {
                  "text": "On battery",
                  "color": "#fab219",
                  "index": 2
                },
                "3": {
                  "text": "On battery",
                  "color": "#fab219",
                  "index": 3
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 4,
                "to": 7,
                "result": {
                  "text": "Check UPS",
                  "color": "#d03b3b",
                  "index": 4
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Network",
          "url": "/d/homelab-network?${__url_time_range}",
          "targetBlank": false
        }
      ],
      "description": "Online and on-battery flags; low battery, shutdown, overload or replacement flags require attention."
    },
