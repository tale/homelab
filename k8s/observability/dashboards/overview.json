  "panels": [
    {
      "id": 3,
      "type": "stat",
      "title": "Active Alerts",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(ALERTS{alertstate=\"firing\",severity=~\"critical|warning\"}) or vector(0)) and on () (sum(up{job=\"vmalert-victoria-metrics-k8s-stack\"}) > 0)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Firing critical and warning alerts. Pending alerts appear in the table below. No data means the alert evaluator is not reporting.",
      "links": [
        {
          "title": "Monitoring",
          "url": "/d/homelab-monitoring?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
