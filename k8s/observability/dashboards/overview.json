    {
      "id": 49,
      "type": "table",
      "title": "Alerts",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(ALERTS{severity=~\"critical|warning\",alertstate=~\"firing|pending\"}) or on () (label_replace(vector(0), \"alertname\", \"No firing or pending alerts\", \"\", \"\") and on () (min(up{job=\"vmalert-victoria-metrics-k8s-stack\"}) == 1))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "critical",
                        "color": "#d03b3b"
                      },
                      "warning": {
                        "text": "warning",
                        "color": "#fab219"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "severity",
                "alertstate",
                "alertname",
                "namespace",
                "pod",
                "container",
                "node",
                "instance",
                "job",
                "persistentvolumeclaim",
                "name"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "severity": 0,
              "alertstate": 1,
              "alertname": 2,
              "namespace": 3,
              "pod": 4,
              "container": 5,
              "node": 6,
              "instance": 7,
              "job": 8,
              "persistentvolumeclaim": 9,
              "name": 10
            },
            "renameByName": {
              "alertstate": "state",
              "alertname": "alert"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "severity",
                "desc": false
              }
            ]
          }
        }
      ],
      "links": [
        {
          "title": "Monitoring",
          "url": "/d/homelab-monitoring?${__url_time_range}",
          "targetBlank": false
        }
      ],
      "description": "Warning and critical alerts, including pending rules. Container identifies separate alerts within the same pod."
    },
    {
      "id": 25,
      "type": "table",
      "title": "Flux Reconciliation",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(flux_resource_info{ready=\"False\",suspended!=\"True\"}) or on () (label_replace(vector(0), \"name\", \"No reconciliation failures\", \"\", \"\") and on () (min(up{job=\"flux-system/flux-operator\"}) == 1 and on() count(flux_resource_info) > 0))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "kind",
                "exported_namespace",
                "name"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "kind": 0,
              "exported_namespace": 1,
              "name": 2
            },
            "renameByName": {
              "exported_namespace": "namespace"
            }
          }
        }
      ],
      "description": "Unsuspended resources reporting Ready=False. Suspended resources are listed under diagnostics."
    },
    {
      "id": 24,
      "type": "table",
      "title": "Endpoint Checks",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(max by(instance)(probe_success{probe_group=~\"published|internet|appliances\"}), \"endpoint\", \"$1\", \"instance\", \"(?:https?://)?(.*)\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "label_replace(max by(instance)(probe_duration_seconds{probe_group=~\"published|internet|appliances\"}), \"endpoint\", \"$1\", \"instance\", \"(?:https?://)?(.*)\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Failed",
                        "color": "#d03b3b"
                      },
                      "1": {
                        "text": "Passing",
                        "color": "#0ca30c"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "endpoint",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "endpoint",
                "Value #A",
                "Value #B"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "endpoint": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "Value #A": "status",
              "Value #B": "duration"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "status",
                "desc": false
              }
            ]
          }
        }
      ],
      "links": [
        {
          "title": "Network",
          "url": "/d/homelab-network?${__url_time_range}",
          "targetBlank": false
        }
      ],
      "description": "Checks run inside the cluster and follow HTTP redirects. These are reachability checks, not application tests."
    },
    {
      "id": 15,
