    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU by Namespace",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\",namespace=~\"${namespace:regex}\"}[5m]))) and (topk(8, sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\",namespace=~\"${namespace:regex}\"}[5m]))) @ end()))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{namespace}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cores",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "fillOpacity": 55,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 8,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "axisBorderShow": false,
            "axisColorMode": "text",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "noValue": "No data"
        },
        "overrides": []
      }
    },
