{
  "uid": "homelab-kubernetes",
  "title": "Kubernetes",
  "tags": [
    "homelab",
    "kubernetes"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "asDropdown": false,
      "tags": [],
      "targetBlank": false,
      "url": "/d/homelab-overview",
      "keepTime": true,
      "includeVars": false,
      "icon": "external link",
      "tooltip": ""
    },
    {
      "title": "Network",
      "type": "link",
      "asDropdown": false,
      "tags": [],
      "targetBlank": false,
      "url": "/d/homelab-network",
      "keepTime": true,
      "includeVars": false,
      "icon": "external link",
      "tooltip": ""
    },
    {
      "title": "Storage & Backups",
      "type": "link",
      "asDropdown": false,
      "tags": [],
      "targetBlank": false,
      "url": "/d/homelab-storage",
      "keepTime": true,
      "includeVars": false,
      "icon": "external link",
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "label": "namespace"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Workload Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes Ready (Cluster)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 2
              },
              {
                "color": "#0ca30c",
                "value": 3
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Expected: three ready nodes; unaffected by namespace selection."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods Not Ready",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((count((kube_pod_status_ready{condition=\"true\",namespace=~\"${namespace:regex}\"} == 0) and on(namespace,pod) (kube_pod_status_phase{phase=~\"Running|Pending\"} == 1))) or vector(0)) and on () (min(up{job=\"kube-state-metrics\"}) == 1)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 4
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Nonterminal pods without Ready=True in the selected namespaces."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pending / Failed Pods",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((count(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\",namespace=~\"${namespace:regex}\"} == 1)) or vector(0)) and on () (min(up{job=\"kube-state-metrics\"}) == 1)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 4
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unavailable Replicas",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(kube_deployment_status_replicas_unavailable{namespace=~\"${namespace:regex}\"}) or vector(0)) + (sum(kube_daemonset_status_number_unavailable{namespace=~\"${namespace:regex}\"}) or vector(0)) + (sum(clamp_min(kube_statefulset_replicas{namespace=~\"${namespace:regex}\"} - kube_statefulset_status_replicas_ready, 0)) or vector(0))) and on () (min(up{job=\"kube-state-metrics\"}) == 1)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 3
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Desired replicas without a ready pod in the selected namespaces."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Restarts (1h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(increase_prometheus(kube_pod_container_status_restarts_total{namespace=~\"${namespace:regex}\"}[1h]))) or vector(0)) and on () (min(up{job=\"kube-state-metrics\"}) == 1)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 10
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Last Exit OOM (24h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((count((kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\",namespace=~\"${namespace:regex}\"} == 1) and on(namespace,pod,container) (kube_pod_container_status_last_terminated_timestamp > time() - 86400))) or vector(0)) and on () (min(up{job=\"kube-state-metrics\"}) == 1)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Containers whose most recent termination was an OOM kill within 24 hours. This is not a count of every OOM event."
    },
    {
      "id": 14,
      "type": "table",
      "title": "Restarting Containers (24h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(topk(15, sum by (namespace, pod, container) (increase_prometheus(kube_pod_container_status_restarts_total{namespace=~\"${namespace:regex}\"}[24h])) > 0)) or on () (label_replace(vector(0), \"pod\", \"No restarts in 24h\", \"\", \"\") and on () (min(up{job=\"kube-state-metrics\"}) == 1))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "namespace",
                "pod",
                "container",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "container": 2,
              "Value": 3
            },
            "renameByName": {
              "Value": "restarts"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "restarts",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "Estimated counter increase over 24 hours for the selected namespaces."
    },
    {
      "id": 101,
      "type": "row",
