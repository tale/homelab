      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: samples/s",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 8,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "axisBorderShow": false,
            "axisColorMode": "text",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "samples/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Rejected Data (24h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(label_replace(sum by(job)(increase_prometheus(vmagent_remotewrite_samples_dropped_total[24h])) > 0, \"reason\", \"remote_write_samples\", \"\", \"\") or (sum by(job,reason)(increase_prometheus(vm_rows_ignored_total[24h])) > 0)) or on () (label_replace(vector(0), \"reason\", \"No rejected data\", \"\", \"\") and on() (min(up{job=~\"vmagent-victoria-metrics-k8s-stack|vmsingle-victoria-metrics-k8s-stack\"}) == 1 and on() count(up{job=~\"vmagent-victoria-metrics-k8s-stack|vmsingle-victoria-metrics-k8s-stack\"}) == 2))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "description": "Estimated rejected sample or metadata counts by component and reason over 24 hours.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "job",
                "reason",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "job": 0,
              "reason": 1,
              "Value": 2
            },
            "renameByName": {
              "job": "component",
              "Value": "rejected"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "rejected",
                "desc": true
              }
            ]
          }
        }
      ]
    },
