    {
      "id": 28,
      "type": "table",
      "title": "Failed Scrape Targets",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(up == 0) or on () (label_replace(vector(0), \"job\", \"No failed scrapes\", \"\", \"\") and on () (min(up{job=\"vmagent-victoria-metrics-k8s-stack\"}) == 1))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "job",
                "namespace",
                "instance",
                "pod"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "job": 0,
              "namespace": 1,
              "instance": 2,
              "pod": 3
            },
            "renameByName": {}
          }
        }
      ],
      "description": "Targets returning up=0. Removed discovery targets are not included."
    },
    {
