    {
      "id": 17,
      "type": "stat",
      "title": "Base Backup Age",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(cnpg_collector_last_available_backup_timestamp > 0)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 86400
              },
              {
                "color": "#d03b3b",
                "value": 172800
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Latest Base Backup",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cnpg_collector_last_failed_backup_timestamp > bool cnpg_collector_last_available_backup_timestamp) + 2 * (max(cnpg_collector_last_available_backup_timestamp) == bool 0)",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Successful",
                  "color": "#0ca30c",
                  "index": 0
                },
                "1": {
                  "text": "Failed",
                  "color": "#d03b3b",
                  "index": 1
                },
                "2": {
                  "text": "No successful backup",
                  "color": "#fab219",
                  "index": 2
                },
                "3": {
                  "text": "No successful backup",
                  "color": "#d03b3b",
                  "index": 3
                }
              }
            }
          ],
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Whether the latest reported Postgres backup attempt failed. Earlier backups may remain usable."
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Backups Out of Sync",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(max by(obj_namespace,obj_name)(volsync_volume_out_of_sync{role=\"source\"}) and on(obj_namespace,obj_name) (max by(obj_namespace,obj_name)(kube_volsync_source_info)))) and on() (min(up{job=\"kube-state-metrics\"}) == 1 and on() min(up{job=\"volsync-metrics\"}) == 1 and on() count(kube_volsync_source_info) > 0) and on() (count(max by(obj_namespace,obj_name)(volsync_volume_out_of_sync{role=\"source\"}) and on(obj_namespace,obj_name) (max by(obj_namespace,obj_name)(kube_volsync_source_info))) == count(max by(obj_namespace,obj_name)(kube_volsync_source_info)))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Current VolSync sources that missed their synchronization deadline. Missing per-source telemetry is not counted as healthy."
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Missed Backup Schedules (24h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase_prometheus(volsync_missed_intervals_total{role=\"source\"}[24h]) and on(obj_namespace,obj_name) (max by(obj_namespace,obj_name)(kube_volsync_source_info)))) and on() (min(up{job=\"kube-state-metrics\"}) == 1 and on() min(up{job=\"volsync-metrics\"}) == 1 and on() count(kube_volsync_source_info) > 0) and on() (count(max by(obj_namespace,obj_name)(volsync_missed_intervals_total{role=\"source\"}) and on(obj_namespace,obj_name) (max by(obj_namespace,obj_name)(kube_volsync_source_info))) == count(max by(obj_namespace,obj_name)(kube_volsync_source_info)))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 3
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "File Backups",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(max by(obj_namespace,obj_name,persistentvolumeclaim,result)(kube_volsync_source_info), \"source\", \"/\", \"obj_namespace\", \"obj_name\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "label_join((max by(obj_namespace,obj_name)(kube_volsync_source_last_sync_timestamp_seconds) * on(obj_namespace,obj_name) group_left(persistentvolumeclaim,result) (max by(obj_namespace,obj_name,persistentvolumeclaim,result)(kube_volsync_source_info))) * 1000, \"source\", \"/\", \"obj_namespace\", \"obj_name\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "label_join(time() - ((max by(obj_namespace,obj_name)(kube_volsync_source_last_sync_timestamp_seconds) * on(obj_namespace,obj_name) group_left(persistentvolumeclaim,result) (max by(obj_namespace,obj_name,persistentvolumeclaim,result)(kube_volsync_source_info))) > 0), \"source\", \"/\", \"obj_namespace\", \"obj_name\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "label_join((max by(obj_namespace,obj_name)(kube_volsync_source_next_sync_timestamp_seconds) * on(obj_namespace,obj_name) group_left(persistentvolumeclaim,result) (max by(obj_namespace,obj_name,persistentvolumeclaim,result)(kube_volsync_source_info))) * 1000, \"source\", \"/\", \"obj_namespace\", \"obj_name\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Not recorded",
                        "color": "#fab219"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "next scheduled"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Not recorded",
                        "color": "#fab219"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
