    },
    {
      "id": 5,
      "type": "stat",
      "title": "Physical Pool Capacity",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (node, name) (diskpool_total_size_bytes))",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Sum of physical pool capacity. Replication reduces the space available for application data."
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "OpenEBS Pool Used",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, name) (diskpool_used_size_bytes) / max by (node, name) (diskpool_total_size_bytes) * 100",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "legendFormat": "{{node}} {{name}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 70
              },
              {
                "color": "#ec835a",
                "value": 85
              },
              {
                "color": "#d03b3b",
                "value": 93
              }
            ]
          },
          "mappings": [],
          "decimals": 1,
          "min": 0,
          "max": 100,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "PVC Capacity",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(((max by(namespace,persistentvolumeclaim)(kubelet_volume_stats_used_bytes)) / (max by(namespace,persistentvolumeclaim)(kubelet_volume_stats_capacity_bytes)) * 100) and on(namespace,persistentvolumeclaim) (max by(namespace,persistentvolumeclaim)(kube_persistentvolumeclaim_info)), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "label_join((max by(namespace,persistentvolumeclaim)(kubelet_volume_stats_used_bytes)) and on(namespace,persistentvolumeclaim) (max by(namespace,persistentvolumeclaim)(kube_persistentvolumeclaim_info)), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "label_join((max by(namespace,persistentvolumeclaim)(kubelet_volume_stats_capacity_bytes)) and on(namespace,persistentvolumeclaim) (max by(namespace,persistentvolumeclaim)(kube_persistentvolumeclaim_info)), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\")",
          "datasource": "VictoriaMetrics",
          "editorMode": "code",
          "range": false,
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "capacity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "description": "Current mounted-volume usage, sorted by utilization.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "claim",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "claim",
                "Value #A",
                "Value #B",
                "Value #C"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "claim": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "Value #A": "used %",
              "Value #B": "used",
              "Value #C": "capacity"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "used %",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Backups",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
