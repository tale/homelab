#!/usr/bin/env bash
#MISE description="Build a flashable RPi4 NUT image with rpi-image-gen"
set -euo pipefail

runtime="$(command -v docker || command -v podman || true)"
[ -n "$runtime" ] || { echo "need docker or podman on PATH" >&2; exit 1; }

rpi="$MISE_PROJECT_ROOT/rpi"

# rpi-image-gen needs a Debian host with CAP_SYS_ADMIN to build its chroot.
# -f is explicit because docker only looks for a file named Dockerfile.
"$runtime" build -t rpi-image-gen -f "$rpi/Containerfile" "$rpi"
# It builds in /build (container-local, case-sensitive) and only the finished
# image is copied back onto the macOS-shared mount. See rpi/Containerfile.
"$runtime" run --rm --privileged -v "$rpi:/rpi" rpi-image-gen \
	sh -c 'rpi-image-gen build -S /rpi/nut -c /rpi/nut/config.yaml \
	  && cp /build/work/image-nut/nut.img /rpi/nut/nut.img'

echo "Flash rpi/nut/nut.img, then boot the Pi 4:"
echo "  sudo dd if=rpi/nut/nut.img of=/dev/rdiskN bs=4m  # macOS (Ctrl-T for progress)"
